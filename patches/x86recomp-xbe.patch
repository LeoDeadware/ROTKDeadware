+      const char* op = m == ZYDIS_MNEMONIC_PAND ? "a & b" : m == ZYDIS_MNEMONIC_PANDN ? "~a & b"
+                       : m == ZYDIS_MNEMONIC_POR ? "a | b" : "a ^ b";
+      std::string b = src(1);
+      L(Fmt("{ const uint64_t a = ::recomp::mmx::Get(c, %d), b = %s;", mm(0), b.c_str()));
+      L("  " + dst(0, op) + " }");
+      return;
+    }
+    case ZYDIS_MNEMONIC_PUNPCKLBW: case ZYDIS_MNEMONIC_PUNPCKLWD: case ZYDIS_MNEMONIC_PUNPCKLDQ:
+    case ZYDIS_MNEMONIC_PUNPCKHBW: case ZYDIS_MNEMONIC_PUNPCKHWD: case ZYDIS_MNEMONIC_PUNPCKHDQ: {
+      if (mm(0) < 0) return Unimpl();
+      const bool high = m == ZYDIS_MNEMONIC_PUNPCKHBW || m == ZYDIS_MNEMONIC_PUNPCKHWD ||
+                        m == ZYDIS_MNEMONIC_PUNPCKHDQ;
+      const char* t = (m == ZYDIS_MNEMONIC_PUNPCKLBW || m == ZYDIS_MNEMONIC_PUNPCKHBW) ? "uint8_t"
+                      : (m == ZYDIS_MNEMONIC_PUNPCKLWD || m == ZYDIS_MNEMONIC_PUNPCKHWD) ? "uint16_t"
+                                                                                       : "uint32_t";
+      std::string b = src(1);  // the low forms read only 32 bits of memory
+      L(Fmt("{ const uint64_t a = ::recomp::mmx::Get(c, %d), b = %s;", mm(0), b.c_str()));
+      L("  " + dst(0, Fmt("::recomp::mmx::Unpack<%s>(a, b, %s)", t, high ? "true" : "false")) + " }");
+      return;
+    }
+    case ZYDIS_MNEMONIC_PACKSSWB: return bin("Pack<int16_t, int8_t>");
+    case ZYDIS_MNEMONIC_PACKSSDW: return bin("Pack<int32_t, int16_t>");
+    case ZYDIS_MNEMONIC_PACKUSWB: return bin("Pack<int16_t, uint8_t>");
+    case ZYDIS_MNEMONIC_PSLLW: return shift("Shl<uint16_t>");
+    case ZYDIS_MNEMONIC_PSLLD: return shift("Shl<uint32_t>");
+    case ZYDIS_MNEMONIC_PSLLQ: return shift("Shl<uint64_t>");
+    case ZYDIS_MNEMONIC_PSRLW: return shift("Shr<uint16_t>");
+    case ZYDIS_MNEMONIC_PSRLD: return shift("Shr<uint32_t>");
+    case ZYDIS_MNEMONIC_PSRLQ: return shift("Shr<uint64_t>");
+    case ZYDIS_MNEMONIC_PSRAW: return shift("Sar<int16_t>");
+    case ZYDIS_MNEMONIC_PSRAD: return shift("Sar<int32_t>");
+    case ZYDIS_MNEMONIC_PSHUFW:
+      if (mm(0) < 0) return Unimpl();
+      L(dst(0, Fmt("::recomp::mmx::ShufW(%s, %uu)", src(1).c_str(),
+                   uint32_t(Op(2).imm.value.u & 0xFF))));
+      return;
+    case ZYDIS_MNEMONIC_PEXTRW:
+      if (mm(1) < 0 || !IsReg(0)) return Unimpl();
+      L(Write(0, Fmt("uint32_t(::recomp::mmx::Lane<uint16_t>(::recomp::mmx::Get(c, %d), %u))",
+                     mm(1), uint32_t(Op(2).imm.value.u & 3))));
+      return;
+    case ZYDIS_MNEMONIC_PINSRW:
+      if (mm(0) < 0) return Unimpl();
+      L(dst(0, Fmt("::recomp::mmx::SetLane<uint16_t>(::recomp::mmx::Get(c, %d), %u, "
+                   "uint16_t(%s))",
+                   mm(0), uint32_t(Op(2).imm.value.u & 3), src(1).c_str())));
+      return;
+    case ZYDIS_MNEMONIC_PMOVMSKB:
+      if (mm(1) < 0 || !IsReg(0)) return Unimpl();
+      L(Write(0, Fmt("::recomp::mmx::MovMskB(::recomp::mmx::Get(c, %d))", mm(1))));
+      return;
+    case ZYDIS_MNEMONIC_CVTPI2PS: {
+      // Two int32 lanes to the two low float lanes, each rounded by MXCSR.
+      if (!IsXmm(0)) return Unimpl();
+      std::string v = src(1);
+      L(Fmt("{ const uint64_t v = %s; ::recomp::Xmm t{};", v.c_str()));
+      for (int i = 0; i < 2; i++) {
+        L(Fmt("  ::recomp::sse::CvtIntToF(c, false, false, uint64_t(int64_t(int32_t(v >> %d))), "
+              "t, %s);", 32 * i, va.c_str()));
+        L(Fmt("  ::recomp::sse::SetLane<uint32_t>(%s, %d, ::recomp::sse::Lane<uint32_t>(t, 0));",
+              XmmRef(0).c_str(), i));
+      }
+      L("}");
+      return;
+    }
+    case ZYDIS_MNEMONIC_CVTPS2PI: case ZYDIS_MNEMONIC_CVTTPS2PI: {
+      if (mm(0) < 0) return Unimpl();
+      const bool trunc = m == ZYDIS_MNEMONIC_CVTTPS2PI;
+      std::string s = IsXmm(1) ? XmmRef(1) : Fmt("::recomp::sse::Ld(B, m1, 8)");
+      L(Fmt("{ const ::recomp::Xmm s = %s; ::recomp::Xmm l{}; uint64_t r = 0;", s.c_str()));
+      for (int i = 0; i < 2; i++) {
+        L(Fmt("  ::recomp::sse::SetLane<uint32_t>(l, 0, ::recomp::sse::Lane<uint32_t>(s, %d));",
+              i));
+        L(Fmt("  r |= uint64_t(::recomp::sse::CvtToI32(c, false, l, %s, %s)) << %d;",
+              trunc ? "true" : "false", va.c_str(), 32 * i));
+      }
+      L(Fmt("  ::recomp::mmx::Set(c, %d, r); }", mm(0)));
+      return;
+    }
+    default:
+      return Unimpl();
+  }
