+// MMX (runtime/mmx.h): registers are the x87 significands; every MMX
+// instruction but EMMS enters MMX state first.
+void InsnEmitter::EmitMmx() {
+  const auto m = d_.mnemonic;
+  if (X64() || !PrepareMem()) return Unimpl();
+  const std::string va = Hex(in_.va);
+  auto mm = [&](int i) -> int {
+    if (!IsReg(i)) return -1;
+    ZydisRegister r = Op(i).reg.value;
+    return r >= ZYDIS_REGISTER_MM0 && r <= ZYDIS_REGISTER_MM7 ? r - ZYDIS_REGISTER_MM0 : -1;
+  };
+  bool any_mm = false;
+  for (int i = 0; i < Nvis(); i++) any_mm |= mm(i) >= 0;
+  if (m == ZYDIS_MNEMONIC_EMMS) {
+    L("::recomp::mmx::Emms(c);");
+    return;
+  }
+  if (any_mm) L("::recomp::mmx::Enter(c);");
+  // Operand i as a uint64_t: MMX register, memory (8 or 4 bytes), GPR.
+  auto src = [&](int i) -> std::string {
+    if (mm(i) >= 0) return Fmt("::recomp::mmx::Get(c, %d)", mm(i));
+    if (IsMem(i))
+      return Bytes(i) == 8 ? Fmt("::recomp::lift::Rd<uint64_t>(B, m%d)", i)
+                           : Fmt("uint64_t(%s)", Read(i).c_str());
+    if (IsReg(i)) return Fmt("uint64_t(%s)", Read(i).c_str());
+    return Fmt("uint64_t(%s)", Hex(uint32_t(Op(i).imm.value.u)).c_str());
+  };
+  auto dst = [&](int i, const std::string& v) -> std::string {
+    if (mm(i) >= 0) return Fmt("::recomp::mmx::Set(c, %d, %s);", mm(i), v.c_str());
+    if (IsMem(i) && Bytes(i) == 8)
+      return Fmt("::recomp::lift::Wr<uint64_t>(B, m%d, %s);", i, v.c_str());
+    return Write(i, Fmt("uint32_t(%s)", v.c_str()));
+  };
+  // dst = f(dst, src) with a helper name and its template argument.
+  auto bin = [&](const char* fn) {
+    if (mm(0) < 0) return Unimpl();
+    std::string b = src(1);
+    L(Fmt("{ const uint64_t a = ::recomp::mmx::Get(c, %d), b = %s;", mm(0), b.c_str()));
+    L("  " + dst(0, Fmt("::recomp::mmx::%s(a, b)", fn)) + " }");
+  };
+  auto shift = [&](const char* fn) {
+    if (mm(0) < 0) return Unimpl();
+    std::string n = IsImm(1) ? Fmt("uint64_t(%u)", uint32_t(Op(1).imm.value.u & 0xFF)) : src(1);
+    L(dst(0, Fmt("::recomp::mmx::%s(::recomp::mmx::Get(c, %d), %s)", fn, mm(0), n.c_str())));
+  };
+  switch (m) {
+    case ZYDIS_MNEMONIC_MOVQ: case ZYDIS_MNEMONIC_MOVNTQ:
+      if (mm(0) < 0 && mm(1) < 0) return Unimpl();
+      if (IsXmm(0) || IsXmm(1)) return Unimpl();  // MOVQ2DQ-like forms
+      L(dst(0, src(1)));
+      return;
+    case ZYDIS_MNEMONIC_MOVD:
+      if (IsXmm(0) || IsXmm(1)) return Unimpl();
+      if (mm(0) >= 0) L(dst(0, Fmt("uint64_t(uint32_t(%s))", src(1).c_str())));
+      else L(Write(0, Fmt("uint32_t(%s)", src(1).c_str())));
+      return;
+    case ZYDIS_MNEMONIC_PADDB: return bin("Add<uint8_t>");
+    case ZYDIS_MNEMONIC_PADDW: return bin("Add<uint16_t>");
+    case ZYDIS_MNEMONIC_PADDD: return bin("Add<uint32_t>");
+    case ZYDIS_MNEMONIC_PADDQ: return bin("Add<uint64_t>");
+    case ZYDIS_MNEMONIC_PADDSB: return bin("AddSat<int8_t>");
+    case ZYDIS_MNEMONIC_PADDSW: return bin("AddSat<int16_t>");
+    case ZYDIS_MNEMONIC_PADDUSB: return bin("AddSat<uint8_t>");
+    case ZYDIS_MNEMONIC_PADDUSW: return bin("AddSat<uint16_t>");
+    case ZYDIS_MNEMONIC_PSUBB: return bin("Sub<uint8_t>");
+    case ZYDIS_MNEMONIC_PSUBW: return bin("Sub<uint16_t>");
+    case ZYDIS_MNEMONIC_PSUBD: return bin("Sub<uint32_t>");
+    case ZYDIS_MNEMONIC_PSUBQ: return bin("Sub<uint64_t>");
+    case ZYDIS_MNEMONIC_PSUBSB: return bin("SubSat<int8_t>");
+    case ZYDIS_MNEMONIC_PSUBSW: return bin("SubSat<int16_t>");
+    case ZYDIS_MNEMONIC_PSUBUSB: return bin("SubSat<uint8_t>");
+    case ZYDIS_MNEMONIC_PSUBUSW: return bin("SubSat<uint16_t>");
+    case ZYDIS_MNEMONIC_PMULLW: return bin("MulLo16");
+    case ZYDIS_MNEMONIC_PMULHW: return bin("MulHi16");
+    case ZYDIS_MNEMONIC_PMULHUW: return bin("MulHiU16");
+    case ZYDIS_MNEMONIC_PMADDWD: return bin("MAddWD");
+    case ZYDIS_MNEMONIC_PSADBW: return bin("SadBW");
+    case ZYDIS_MNEMONIC_PAVGB: return bin("Avg<uint8_t>");
+    case ZYDIS_MNEMONIC_PAVGW: return bin("Avg<uint16_t>");
+    case ZYDIS_MNEMONIC_PMINUB: return bin("Min<uint8_t>");
+    case ZYDIS_MNEMONIC_PMAXUB: return bin("Max<uint8_t>");
+    case ZYDIS_MNEMONIC_PMINSW: return bin("Min<int16_t>");
+    case ZYDIS_MNEMONIC_PMAXSW: return bin("Max<int16_t>");
+    case ZYDIS_MNEMONIC_PCMPEQB: return bin("CmpEq<uint8_t>");
+    case ZYDIS_MNEMONIC_PCMPEQW: return bin("CmpEq<uint16_t>");
+    case ZYDIS_MNEMONIC_PCMPEQD: return bin("CmpEq<uint32_t>");
+    case ZYDIS_MNEMONIC_PCMPGTB: return bin("CmpGt<int8_t>");
+    case ZYDIS_MNEMONIC_PCMPGTW: return bin("CmpGt<int16_t>");
+    case ZYDIS_MNEMONIC_PCMPGTD: return bin("CmpGt<int32_t>");
