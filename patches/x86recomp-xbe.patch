+// MMX: an MMX register operand, EMMS, or a conversion between MMX and SSE
+// registers (their memory forms included).
+bool IsMmx(const ZydisDecodedInstruction& d, const ZydisDecodedOperand* ops) {
+  switch (d.mnemonic) {
+    case ZYDIS_MNEMONIC_EMMS: case ZYDIS_MNEMONIC_CVTPI2PS:
+    case ZYDIS_MNEMONIC_CVTPS2PI: case ZYDIS_MNEMONIC_CVTTPS2PI:
+      return true;
+    default:
+      break;
+  }
+  for (int i = 0; i < d.operand_count_visible; i++)
+    if (ops[i].type == ZYDIS_OPERAND_TYPE_REGISTER &&
+        ZydisRegisterGetClass(ops[i].reg.value) == ZYDIS_REGCLASS_MMX)
+      return true;
+  return false;
+}
