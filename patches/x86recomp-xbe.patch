diff --git a/src/runtime/mmx.h b/src/runtime/mmx.h
new file mode 100644
index 0000000..64573db
--- /dev/null
+++ b/src/runtime/mmx.h
@@ -0,0 +1,160 @@
+#pragma once
+// MMX for lifted code: the eight 64-bit MMX registers are the significands
+// of the x87 physical registers R0..R7, as on the CPU. Every MMX
+// instruction (EMMS excepted) puts the x87 unit in MMX state: TOP = 0, all
+// tags valid; a register write also sets that register's sign/exponent to
+// all ones. EMMS marks every register empty. Integer lane arithmetic only,
+// on uint64_t values, little-endian lanes; portable C++ (no intrinsics).
+
+#include <cstdint>
+#include <type_traits>
+
+#include "runtime/ctx.h"
+
+namespace recomp::mmx {
+
+[[gnu::always_inline]] inline void Enter(Ctx& c) {
+  c.fpu.top = 0;
+  c.fpu.empty = 0;
+}
+[[gnu::always_inline]] inline uint64_t Get(const Ctx& c, int i) { return c.fpu.r[i].sig; }
+[[gnu::always_inline]] inline void Set(Ctx& c, int i, uint64_t v) {
+  c.fpu.r[i].sig = v;
+  c.fpu.r[i].se = 0xFFFF;
+}
+[[gnu::always_inline]] inline void Emms(Ctx& c) { c.fpu.empty = 0xFF; }
+
+// ---- lanes ------------------------------------------------------------------
+template <typename T>
+inline T Lane(uint64_t v, int i) {
+  return T(v >> (8 * sizeof(T) * i));
+}
+template <typename T>
+inline uint64_t SetLane(uint64_t v, int i, T x) {
+  const int sh = 8 * sizeof(T) * i;
+  const uint64_t mask = (sizeof(T) == 8 ? ~0ull : ((1ull << (8 * sizeof(T))) - 1)) << sh;
+  using U = std::make_unsigned_t<T>;
+  return (v & ~mask) | (uint64_t(U(x)) << sh);
+}
+// d[i] = f(a[i], b[i]) for every lane of type T.
+template <typename T, typename F>
+inline uint64_t Map2(uint64_t a, uint64_t b, F f) {
+  uint64_t r = 0;
+  for (int i = 0; i < int(8 / sizeof(T)); i++) r = SetLane<T>(r, i, T(f(Lane<T>(a, i), Lane<T>(b, i))));
+  return r;
+}
+template <typename T>
+inline T Sat(int64_t v) {
+  constexpr int64_t lo = std::is_signed_v<T> ? -(int64_t(1) << (8 * sizeof(T) - 1)) : 0;
+  constexpr int64_t hi = std::is_signed_v<T> ? (int64_t(1) << (8 * sizeof(T) - 1)) - 1
+                                             : (int64_t(1) << (8 * sizeof(T))) - 1;
+  return T(v < lo ? lo : v > hi ? hi : v);
+}
+
+// Wrapping, saturating (S signed, US unsigned) add/sub.
+template <typename T> inline uint64_t Add(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return T(x + y); });
+}
+template <typename T> inline uint64_t Sub(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return T(x - y); });
+}
+template <typename T> inline uint64_t AddSat(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return Sat<T>(int64_t(x) + int64_t(y)); });
+}
+template <typename T> inline uint64_t SubSat(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return Sat<T>(int64_t(x) - int64_t(y)); });
+}
+template <typename T> inline uint64_t CmpEq(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return x == y ? T(~T(0)) : T(0); });
+}
+template <typename T> inline uint64_t CmpGt(uint64_t a, uint64_t b) {  // T signed
+  return Map2<T>(a, b, [](T x, T y) { return x > y ? T(~T(0)) : T(0); });
+}
+template <typename T> inline uint64_t Min(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return x < y ? x : y; });
+}
+template <typename T> inline uint64_t Max(uint64_t a, uint64_t b) {
+  return Map2<T>(a, b, [](T x, T y) { return x > y ? x : y; });
+}
+template <typename T> inline uint64_t Avg(uint64_t a, uint64_t b) {  // T unsigned
+  return Map2<T>(a, b, [](T x, T y) { return T((uint32_t(x) + uint32_t(y) + 1) >> 1); });
+}
+inline uint64_t MulLo16(uint64_t a, uint64_t b) {
+  return Map2<int16_t>(a, b, [](int16_t x, int16_t y) { return int16_t(int32_t(x) * y); });
+}
+inline uint64_t MulHi16(uint64_t a, uint64_t b) {
+  return Map2<int16_t>(a, b, [](int16_t x, int16_t y) { return int16_t((int32_t(x) * y) >> 16); });
+}
+inline uint64_t MulHiU16(uint64_t a, uint64_t b) {
+  return Map2<uint16_t>(a, b,
+                        [](uint16_t x, uint16_t y) { return uint16_t((uint32_t(x) * y) >> 16); });
+}
+// PMADDWD: d.dword[i] = a.w[2i]*b.w[2i] + a.w[2i+1]*b.w[2i+1] (wraps only
+// for 0x8000 * 0x8000 twice, as on the CPU).
+inline uint64_t MAddWD(uint64_t a, uint64_t b) {
+  uint64_t r = 0;
+  for (int i = 0; i < 2; i++) {
+    int32_t p0 = int32_t(Lane<int16_t>(a, 2 * i)) * Lane<int16_t>(b, 2 * i);
+    int32_t p1 = int32_t(Lane<int16_t>(a, 2 * i + 1)) * Lane<int16_t>(b, 2 * i + 1);
+    r = SetLane<uint32_t>(r, i, uint32_t(p0) + uint32_t(p1));
+  }
+  return r;
+}
+// PSADBW: sum of absolute byte differences in the low word.
+inline uint64_t SadBW(uint64_t a, uint64_t b) {
+  uint32_t s = 0;
+  for (int i = 0; i < 8; i++) {
+    int d = int(Lane<uint8_t>(a, i)) - int(Lane<uint8_t>(b, i));
+    s += uint32_t(d < 0 ? -d : d);
+  }
+  return s;
+}
+
+// Shifts by a 64-bit count: logical shifts past the lane width give 0,
+// arithmetic ones the sign.
+template <typename T> inline uint64_t Shl(uint64_t a, uint64_t n) {
+  if (n >= 8 * sizeof(T)) return 0;
+  return Map2<T>(a, 0, [n](T x, T) { return T(x << n); });
+}
+template <typename T> inline uint64_t Shr(uint64_t a, uint64_t n) {  // T unsigned
+  if (n >= 8 * sizeof(T)) return 0;
+  return Map2<T>(a, 0, [n](T x, T) { return T(x >> n); });
+}
+template <typename T> inline uint64_t Sar(uint64_t a, uint64_t n) {  // T signed
+  if (n >= 8 * sizeof(T)) n = 8 * sizeof(T) - 1;
+  return Map2<T>(a, 0, [n](T x, T) { return T(x >> n); });
+}
+
+// Unpack: interleave the low (high = false) or high halves, a first.
+template <typename T> inline uint64_t Unpack(uint64_t a, uint64_t b, bool high) {
+  constexpr int n = 8 / sizeof(T);
+  uint64_t r = 0;
+  for (int i = 0; i < n / 2; i++) {
+    int src = high ? n / 2 + i : i;
+    r = SetLane<T>(r, 2 * i, Lane<T>(a, src));
+    r = SetLane<T>(r, 2 * i + 1, Lane<T>(b, src));
+  }
+  return r;
+}
+// Pack with saturation: a's lanes then b's, narrowed from W to N.
+template <typename W, typename N> inline uint64_t Pack(uint64_t a, uint64_t b) {
+  constexpr int n = 8 / sizeof(W);
+  uint64_t r = 0;
+  for (int i = 0; i < n; i++) {
+    r = SetLane<N>(r, i, Sat<N>(Lane<W>(a, i)));
+    r = SetLane<N>(r, n + i, Sat<N>(Lane<W>(b, i)));
+  }
+  return r;
+}
+inline uint64_t ShufW(uint64_t a, uint32_t imm) {
+  uint64_t r = 0;
+  for (int i = 0; i < 4; i++) r = SetLane<uint16_t>(r, i, Lane<uint16_t>(a, (imm >> (2 * i)) & 3));
+  return r;
+}
+inline uint32_t MovMskB(uint64_t a) {
+  uint32_t m = 0;
+  for (int i = 0; i < 8; i++) m |= uint32_t(Lane<uint8_t>(a, i) >> 7) << i;
+  return m;
+}
+
+}  // namespace recomp::mmx
diff --git a/src/runtime/xbe_image.cpp b/src/runtime/xbe_image.cpp
new file mode 100644
index 0000000..2f80a06
--- /dev/null
+++ b/src/runtime/xbe_image.cpp
@@ -0,0 +1,172 @@
+#include "runtime/xbe_image.h"
+
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+namespace recomp {
+
+namespace {
+
+constexpr uint32_t kEntryRetail = 0xA8FC57AB, kEntryDebug = 0x94859D4B;
+constexpr uint32_t kThunkRetail = 0x5B6D40B6, kThunkDebug = 0xEFB1F152;
+constexpr uint32_t kSecWritable = 0x1, kSecExecutable = 0x4;
+// PE section characteristics given to XBE sections.
+constexpr uint32_t kScnCode = 0x00000020, kScnExec = 0x20000000,
+                   kScnRead = 0x40000000, kScnWrite = 0x80000000;
+
+template <typename T>
+T Rd(const std::vector<uint8_t>& d, size_t off) {
+  T v{};
+  if (off + sizeof(T) <= d.size()) std::memcpy(&v, d.data() + off, sizeof(T));
+  return v;
+}
+
+}  // namespace
+
+bool IsXbeFile(const std::string& path) {
+  std::ifstream f(path, std::ios::binary);
+  char m[4] = {};
+  f.read(m, 4);
+  return f && std::memcmp(m, "XBEH", 4) == 0;
+}
+
+bool LoadXbe(const std::string& path, GuestMemory& mem, PeImage* img,
+             XbeInfo* info, std::string* err) {
+  *img = PeImage{};
+  *info = XbeInfo{};
+  std::ifstream f(path, std::ios::binary);
+  if (!f) {
+    *err = "cannot open " + path;
+    return false;
+  }
+  std::vector<uint8_t> d((std::istreambuf_iterator<char>(f)),
+                         std::istreambuf_iterator<char>());
+  if (d.size() < 0x180 || std::memcmp(d.data(), "XBEH", 4) != 0) {
+    *err = "not an XBE";
+    return false;
+  }
+  const uint32_t base = Rd<uint32_t>(d, 0x104);
+  const uint32_t headers = Rd<uint32_t>(d, 0x108);
+  img->preferred_base = img->image_base = base;
+  img->image_size = Rd<uint32_t>(d, 0x10C);
+  info->headers_size = headers;
+  info->cert = Rd<uint32_t>(d, 0x118);
+  info->tls_dir = Rd<uint32_t>(d, 0x12C);
+  info->stack_commit = Rd<uint32_t>(d, 0x130);
+  info->heap_reserve = Rd<uint32_t>(d, 0x134);
+  info->heap_commit = Rd<uint32_t>(d, 0x138);
+  img->stack_reserve = info->stack_commit;
+  if (headers > d.size() || uint64_t(base) + img->image_size > mem.size()) {
+    *err = "bad XBE header sizes";
+    return false;
+  }
+  auto file_off = [&](uint32_t va) -> size_t { return va - base; };  // headers only
+
+  if (!mem.Commit(base, img->image_size, Prot::RW)) {
+    *err = "cannot commit the XBE image range";
+    return false;
+  }
+  std::memcpy(mem.ptr(base), d.data(), headers);
+
+  const uint32_t nsec = Rd<uint32_t>(d, 0x11C);
+  const uint32_t sh = Rd<uint32_t>(d, 0x120);
+  for (uint32_t i = 0; i < nsec; i++) {
+    size_t o = file_off(sh) + i * 56;
+    uint32_t flags = Rd<uint32_t>(d, o), va = Rd<uint32_t>(d, o + 4),
+             vsize = Rd<uint32_t>(d, o + 8), raw = Rd<uint32_t>(d, o + 12),
+             rsize = Rd<uint32_t>(d, o + 16), name_va = Rd<uint32_t>(d, o + 20);
+    if (va < base || uint64_t(va) + vsize > uint64_t(base) + img->image_size ||
+        uint64_t(raw) + rsize > d.size() || rsize > vsize) {
+      *err = "section " + std::to_string(i) + " out of range";
+      return false;
+    }
+    PeSection s;
+    size_t no = file_off(name_va);
+    while (no < headers && d[no]) s.name += char(d[no++]);
+    s.va = va;
+    s.vsize = vsize;
+    s.characteristics = kScnRead | ((flags & kSecWritable) ? kScnWrite : 0) |
+                        ((flags & kSecExecutable) ? kScnCode | kScnExec : 0);
+    img->sections.push_back(s);
+    std::memcpy(mem.ptr(va), d.data() + raw, rsize);
+  }
+
+  // Entry point: whichever key puts it inside a section.
+  auto in_section = [&](uint32_t va) {
+    for (const auto& s : img->sections)
+      if (va >= s.va && va < s.va + s.vsize) return true;
+    return false;
+  };
+  uint32_t enc = Rd<uint32_t>(d, 0x128);
+  uint32_t entry = enc ^ kEntryRetail;
+  if (!in_section(entry)) {
+    entry = enc ^ kEntryDebug;
+    info->debug_key = true;
+    if (!in_section(entry)) {
+      *err = "entry point decodes outside every section";
+      return false;
+    }
+  }
+  img->entry = entry;
+  info->kernel_thunk =
+      Rd<uint32_t>(d, 0x158) ^ (info->debug_key ? kThunkDebug : kThunkRetail);
+
+  // Kernel imports, by ordinal.
+  for (uint32_t a = info->kernel_thunk;; a += 4) {
+    if (!in_section(a)) {
+      *err = "kernel thunk table runs out of the image";
+      return false;
+    }
+    uint32_t v = mem.read<uint32_t>(a);
+    if (!v) break;
+    PeImport imp;
+    imp.dll = "xboxkrnl.exe";
+    imp.name = "#" + std::to_string(v & 0x7FFFFFFF);
+    imp.iat_va = a;
+    imp.thunk_va = 0;
+    img->imports.push_back(imp);
+  }
+
+  // Code: executable sections back to back from .text.
+  const PeSection* text = nullptr;
+  for (const auto& s : img->sections)
+    if (s.name == ".text") text = &s;
+  if (!text) {
+    *err = "no .text section";
+    return false;
+  }
+  info->code_lo = text->va;
+  info->code_hi = text->va + text->vsize;
+  // Linkers flag data sections executable too, so the run also ends at the
+  // section holding the kernel thunk table (the start of read-only data)
+  // and at the usual data section names.
+  auto is_data = [&](const PeSection& s) {
+    return s.name == ".rdata" || s.name == ".data" || s.name == ".bss" ||
+           (info->kernel_thunk >= s.va && info->kernel_thunk < s.va + s.vsize);
+  };
+  for (bool grew = true; grew;) {
+    grew = false;
+    for (const auto& s : img->sections)
+      if ((s.characteristics & kScnExec) && !is_data(s) && s.va >= info->code_hi &&
+          s.va - info->code_hi < 0x20) {  // sections are 16/32-byte aligned
+        info->code_hi = s.va + s.vsize;
+        grew = true;
+      }
+  }
+
+  // TLS directory: raw start, raw end, index VA, callbacks, zero fill.
+  // (It may sit in a section or in the header area.)
+  if (info->tls_dir >= base && info->tls_dir + 24 <= base + img->image_size) {
+    img->has_tls = true;
+    img->tls.raw_start = mem.read<uint32_t>(info->tls_dir);
+    img->tls.raw_end = mem.read<uint32_t>(info->tls_dir + 4);
+    img->tls.index_va = mem.read<uint32_t>(info->tls_dir + 8);
+    img->tls.callbacks = mem.read<uint32_t>(info->tls_dir + 12);
+    img->tls.zero_fill = mem.read<uint32_t>(info->tls_dir + 16);
+  }
+  return true;
+}
+
+}  // namespace recomp
diff --git a/src/runtime/xbe_image.h b/src/runtime/xbe_image.h
new file mode 100644
index 0000000..c80c034
--- /dev/null
+++ b/src/runtime/xbe_image.h
@@ -0,0 +1,44 @@
+#pragma once
+// Maps an original Xbox executable (XBE) into the guest address space and
+// describes it as a PeImage, so the lifter and runtimes that know PE images
+// can take it unchanged.
+//
+// - The image header and every section are mapped at their VAs (XBEs are
+//   never relocated).
+// - Entry point and kernel thunk table address are stored XOR-ed with a
+//   retail or a debug key; the key whose entry lands inside a section wins.
+// - The kernel thunk table holds one slot per xboxkrnl.exe import, as
+//   0x80000000 | ordinal, up to a zero slot. Each becomes a PeImport of
+//   dll "xboxkrnl.exe", name "#<ordinal>", with iat_va the slot. Slots are
+//   left as in the file: the runtime binds them.
+// - Code sections: executable sections laid out back to back from .text
+//   (the XDK libraries' own sections follow it). `code_hi` is the end of the
+//   last of them. XBE linkers flag data sections executable too, so the run
+//   stops at the section holding the kernel thunk table (start of read-only
+//   data) and at .rdata/.data/.bss; executable sections elsewhere (DSP code)
+//   are not x86 either.
+
+#include <string>
+
+#include "runtime/pe_image.h"
+
+namespace recomp {
+
+struct XbeInfo {
+  gaddr headers_size = 0;
+  gaddr cert = 0;          // certificate VA
+  gaddr tls_dir = 0;       // TLS directory VA, 0 if none
+  gaddr kernel_thunk = 0;  // decoded thunk table VA
+  uint32_t stack_commit = 0, heap_reserve = 0, heap_commit = 0;
+  gaddr code_lo = 0, code_hi = 0;
+  bool debug_key = false;
+};
+
+// True if the file starts with the XBE magic ("XBEH").
+bool IsXbeFile(const std::string& path);
+
+// Fills img (sections, entry, imports, TLS) and maps the image into mem.
+bool LoadXbe(const std::string& path, GuestMemory& mem, PeImage* img,
+             XbeInfo* info, std::string* err);
+
+}  // namespace recomp
