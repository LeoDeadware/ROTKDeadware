+  } else {
+    vec2 d = 1.0 / dst.xy;
+    c = CatmullRom(uv);
+    vec3 n = CatmullRom(uv + vec2(d.x, 0.0)) + CatmullRom(uv - vec2(d.x, 0.0)) +
