+  //  e f g h
+  //  i j k l
+  //    n o
+  vec3 b = Texel(i + ivec2(0, -1)), c = Texel(i + ivec2(1, -1));
+  vec3 e = Texel(i + ivec2(-1, 0)), f = Texel(i), g = Texel(i + ivec2(1, 0)),
+       h = Texel(i + ivec2(2, 0));
+  vec3 ii = Texel(i + ivec2(-1, 1)), j = Texel(i + ivec2(0, 1)), k = Texel(i + ivec2(1, 1)),
+       l = Texel(i + ivec2(2, 1));
+  vec3 n = Texel(i + ivec2(0, 2)), o = Texel(i + ivec2(1, 2));
+  float bL = Luma(b), cL = Luma(c), eL = Luma(e), fL = Luma(f), gL = Luma(g), hL = Luma(h);
+  float iL = Luma(ii), jL = Luma(j), kL = Luma(k), lL = Luma(l), nL = Luma(n), oL = Luma(o);
+  vec2 dir = vec2(0.0);
+  float len = 0.0;
+  EasuSet(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+  EasuSet(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+  EasuSet(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+  EasuSet(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+  float dirR = dir.x * dir.x + dir.y * dir.y;
+  bool zro = dirR < 1.0 / 32768.0;
+  dirR = zro ? 1.0 : inversesqrt(dirR);
+  dir.x = zro ? 1.0 : dir.x;
+  dir *= dirR;
+  len = len * 0.5;
+  len *= len;
+  float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+  vec2 len2 = vec2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+  float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+  float clp = 1.0 / lob;
+  vec3 ac = vec3(0.0);
+  float aw = 0.0;
+  EasuTap(ac, aw, vec2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+  EasuTap(ac, aw, vec2(1.0, -1.0) - pp, dir, len2, lob, clp, c);
+  EasuTap(ac, aw, vec2(-1.0, 1.0) - pp, dir, len2, lob, clp, ii);
+  EasuTap(ac, aw, vec2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+  EasuTap(ac, aw, vec2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+  EasuTap(ac, aw, vec2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+  EasuTap(ac, aw, vec2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+  EasuTap(ac, aw, vec2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+  EasuTap(ac, aw, vec2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+  EasuTap(ac, aw, vec2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+  EasuTap(ac, aw, vec2(1.0, 2.0) - pp, dir, len2, lob, clp, o);
+  EasuTap(ac, aw, vec2(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+  // Deringing: stay within the four nearest input pixels.
+  vec3 mn = min(min(f, g), min(j, k)), mx = max(max(f, g), max(j, k));
+  return clamp(ac / aw, mn, mx);
+}
+
+// ---- FSR 1: RCAS, sharpness 0.2 stops (FidelityFX's default), over the
+// EASU pass's result (src, size = its size).
+vec3 Rcas(vec2 uv) {
+  ivec2 ip = ivec2(uv * size.xy);
+  vec3 e = Texel(ip);
+  vec3 b = Texel(ip + ivec2(0, -1)), d = Texel(ip + ivec2(-1, 0));
+  vec3 f = Texel(ip + ivec2(1, 0)), h = Texel(ip + ivec2(0, 1));
+  vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
+  vec3 hitMin = min(mn4, e) / (4.0 * mx4 + 1e-5);
+  vec3 hitMax = (1.0 - max(mx4, e)) / (4.0 * min(mn4, e) - 4.0 - 1e-5);
+  vec3 lobeRGB = max(-hitMin, hitMax);
+  const float kSharpness = exp2(-0.2);
+  float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobeRGB.r, max(lobeRGB.g, lobeRGB.b)), 0.0)) *
+               kSharpness;
+  return clamp((lobe * (b + d + h + f) + e) / (4.0 * lobe + 1.0), 0.0, 1.0);
+}
+
+void main() {
+  vec3 c;
+  if (mode.x == 4) {
+    c = Easu(uv * dst.xy);
+  } else if (mode.x == 5) {
+    c = Rcas(uv);
+  } else if (mode.x == 0) {
+    c = Sharp(uv);
+  } else if (mode.x == 1) {
+    c = CatmullRom(uv);
+  } else if (mode.x == 2) {
