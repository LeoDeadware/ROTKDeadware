From d4cc7cc590300ce9435f45059fe49be0f07d95cf Mon Sep 17 00:00:00 2001
From: Deadware <noreply@deadware.invalid>
Date: Mon, 2 Nov 2026 19:36:56 +0200
Subject: [PATCH] sse: host fast path under the default MXCSR

Lanes on host float/double when MXCSR's control bits are the default (RN,
all masked, no FTZ/DAZ): bit-exact for every non-NaN result (IEEE basic ops
are correctly rounded on every host); a NaN result, or a NaN operand of a
float<->float conversion, redoes the instruction on the exact SoftFloat
path. The MXCSR sticky flags are not accumulated on the fast path
(g_host_fast = false for guests that read MXCSR). Removes SoftFloat's
thread-local rounding/flags traffic from every SSE instruction.
RSQRTPS's first guess uses host doubles (same three RN roundings).
tests/sse_fast_test: fast vs exact path on special and random operands.
---
 src/runtime/sse.cpp     | 231 ++++++++++++++++++++++++++++++++++++++--
 src/runtime/sse.h       |  11 +-
 tests/CMakeLists.txt    |   8 ++
 tests/sse_fast_test.cpp | 230 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 473 insertions(+), 7 deletions(-)
 create mode 100644 tests/sse_fast_test.cpp

diff --git a/src/runtime/sse.cpp b/src/runtime/sse.cpp
index c074065..7bab109 100644
--- a/src/runtime/sse.cpp
+++ b/src/runtime/sse.cpp
@@ -7,9 +7,35 @@
 // goes to SoftFloat, whose 8086 specialization already matches x86 for
 // non-NaN inputs: default NaN 0xFFC00000 / 0xFFF8000000000000, tininess
 // after rounding, 0x80000000 for out-of-range conversions.
+//
+// Host fast path (g_host_fast, on by default). Under the default MXCSR
+// control bits (RN, all exceptions masked, FTZ and DAZ clear; the sticky
+// flag bits may hold anything) lanes are computed with the host's own
+// binary32/binary64 arithmetic. Proof of exactness: IEEE 754 add, sub,
+// mul, div, sqrt and the int/float conversions are correctly rounded (or
+// exact) on every conforming host, so in round-to-nearest-even a non-NaN
+// result is the one SoftFloat - and the x86 hardware - gives, bit for bit,
+// denormal results and operands included (the host flushes nothing,
+// platform::HostFpProblem). Comparisons, MIN/MAX and the conversions to
+// integers are exact by definition (no rounding, or rounding of an
+// already-integral value; NaN and out of range give the x86 integer
+// indefinite explicitly). Only NaN results differ between hosts (payload
+// choice, the sign of the default NaN), so a NaN result sends the whole
+// instruction to the exact path, as does a NaN operand of a float<->float
+// conversion. Needs -ffp-contract=off and no fast-math
+// (RECOMP_X87_FP_FLAGS): no FMA contraction of a separate mul and add.
+//
+// What the fast path does not do: accumulate the MXCSR sticky flags
+// (IE DE ZE OE UE PE). Masked, they are only visible to a guest that reads
+// MXCSR (STMXCSR, FXSAVE); a title that does clears g_host_fast. Every
+// other MXCSR value takes the exact path. tests/sse_fast_test compares
+// the two paths on random and special operands.
 
 #include "runtime/sse.h"
 
+#include <bit>
+#include <cmath>
+
 extern "C" {
 #include "softfloat.h"
 }
@@ -109,6 +135,123 @@ struct Scope {
   }
 };
 
+// ---- host fast path (see the top of this file) --------------------------
+// The 0xFFC0 part of MXCSR: DAZ (6), the masks (7-12), RC (13-14), FTZ (15).
+[[gnu::always_inline]] inline bool Fast(const Ctx& c) {
+  return (c.mxcsr & 0xFFC0u) == kMxcsrDefault && g_host_fast;
+}
+
+template <bool D>
+using HostF = std::conditional_t<D, double, float>;
+
+template <bool D>
+[[gnu::always_inline]] inline HostF<D> HL(const Xmm& x, int i) {
+  return std::bit_cast<HostF<D>>(Lane<typename Fmt<D>::U>(x, i));
+}
+template <bool D>
+[[gnu::always_inline]] inline void HSet(Xmm& x, int i, HostF<D> v) {
+  SetLane<typename Fmt<D>::U>(x, i, std::bit_cast<typename Fmt<D>::U>(v));
+}
+
+template <bool D, Op O>
+[[gnu::always_inline]] inline bool ArithFastOp(int lanes, Xmm& d, const Xmm& s) {
+  Xmm r = d;
+  bool nan = false;
+  for (int i = 0; i < lanes; i++) {
+    const HostF<D> a = HL<D>(d, i), b = HL<D>(s, i);
+    HostF<D> v;
+    if constexpr (O == kAdd)
+      v = a + b;
+    else if constexpr (O == kSub)
+      v = a - b;
+    else if constexpr (O == kMul)
+      v = a * b;
+    else
+      v = a / b;
+    nan |= v != v;
+    HSet<D>(r, i, v);
+  }
+  if (nan) return false;
+  d = r;
+  return true;
+}
+
+template <bool D>
+bool ArithFast(Op op, int lanes, Xmm& d, const Xmm& s) {
+  switch (op) {
+    case kAdd: return ArithFastOp<D, kAdd>(lanes, d, s);
+    case kSub: return ArithFastOp<D, kSub>(lanes, d, s);
+    case kMul: return ArithFastOp<D, kMul>(lanes, d, s);
+    default: return ArithFastOp<D, kDiv>(lanes, d, s);
+  }
+}
+
+template <bool D>
+bool SqrtFast(int lanes, Xmm& d, const Xmm& s) {
+  Xmm r = d;
+  bool nan = false;
+  for (int i = 0; i < lanes; i++) {
+    const HostF<D> v = std::sqrt(HL<D>(s, i));
+    nan |= v != v;
+    HSet<D>(r, i, v);
+  }
+  if (nan) return false;
+  d = r;
+  return true;
+}
+
+// A compare and a select: NaNs and equal values (zeros of either sign
+// too) give s, as the hardware does. No result is computed, so no fallback.
+template <bool D>
+void MinMaxFast(bool max, int lanes, Xmm& d, const Xmm& s) {
+  using U = typename Fmt<D>::U;
+  Xmm r = d;
+  for (int i = 0; i < lanes; i++) {
+    const HostF<D> a = HL<D>(d, i), b = HL<D>(s, i);
+    const bool take_a = max ? a > b : a < b;
+    SetLane<U>(r, i, take_a ? Lane<U>(d, i) : Lane<U>(s, i));
+  }
+  d = r;
+}
+
+template <bool D>
+[[gnu::always_inline]] inline bool CmpLane(HostF<D> a, HostF<D> b, uint8_t pred) {
+  switch (pred & 7) {
+    case 0: return a == b;
+    case 1: return a < b;
+    case 2: return a <= b;
+    case 3: return a != a || b != b;
+    case 4: return !(a == b);
+    case 5: return !(a < b);
+    case 6: return !(a <= b);
+    default: return a == a && b == b;
+  }
+}
+
+template <bool D>
+void CmpFast(int lanes, Xmm& d, const Xmm& s, uint8_t pred) {
+  using U = typename Fmt<D>::U;
+  Xmm r = d;
+  for (int i = 0; i < lanes; i++)
+    SetLane<U>(r, i, CmpLane<D>(HL<D>(d, i), HL<D>(s, i), pred) ? U(~U(0)) : U(0));
+  d = r;
+}
+
+// x, already integral, as I; the x86 integer indefinite (the minimum
+// value) for NaN and out of range. -2^(n-1) itself is in range.
+template <typename I, typename F>
+[[gnu::always_inline]] inline I ToIntIndefinite(F x) {
+  constexpr F kLim = F(uint64_t(1) << (sizeof(I) * 8 - 1));  // 2^31 or 2^63, exact
+  if (x >= -kLim && x < kLim) return I(x);
+  return std::numeric_limits<I>::min();
+}
+// CVTT*2SI (truncate) or CVT*2SI under RN: nearbyint rounds to nearest
+// even in the host's default mode.
+template <typename I, typename F>
+[[gnu::always_inline]] inline I CvtHost(F x, bool truncate) {
+  return ToIntIndefinite<I>(truncate ? std::trunc(x) : std::nearbyint(x));
+}
+
 template <bool D>
 typename Fmt<D>::U ArithLane(Scope& sc, Op op, typename Fmt<D>::U a,
                              typename Fmt<D>::U b) {
@@ -306,8 +449,12 @@ void CheckAligned(Ctx& c, uint64_t a, uint64_t va, unsigned align) {
            (unsigned long long)a, (unsigned long long)va);
 }
 
+bool g_host_fast = true;
+
 void Arith(Ctx& c, Op op, bool dbl, int lanes, Xmm& d, const Xmm& s,
            uint64_t va) {
+  if (Fast(c) && (dbl ? ArithFast<true>(op, lanes, d, s) : ArithFast<false>(op, lanes, d, s)))
+    return;
   if (dbl)
     ArithT<true>(c, op, lanes, d, s, va);
   else
@@ -316,6 +463,13 @@ void Arith(Ctx& c, Op op, bool dbl, int lanes, Xmm& d, const Xmm& s,
 
 void Cmp(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint8_t pred,
          uint64_t va) {
+  if (Fast(c)) {
+    if (dbl)
+      CmpFast<true>(lanes, d, s, pred);
+    else
+      CmpFast<false>(lanes, d, s, pred);
+    return;
+  }
   if (dbl)
     CmpT<true>(c, lanes, d, s, pred, va);
   else
@@ -324,10 +478,16 @@ void Cmp(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint8_t pred,
 
 int Comi(Ctx& c, bool dbl, bool ordered, const Xmm& a, const Xmm& b,
          uint64_t va) {
+  if (Fast(c)) {  // 0 greater, 1 less, 2 equal, 3 unordered
+    auto order = [](auto x, auto y) { return x > y ? 0 : x < y ? 1 : x == y ? 2 : 3; };
+    return dbl ? order(HL<true>(a, 0), HL<true>(b, 0)) : order(HL<false>(a, 0), HL<false>(b, 0));
+  }
   return dbl ? ComiT<true>(c, ordered, a, b, va) : ComiT<false>(c, ordered, a, b, va);
 }
 
 void Sqrt(Ctx& c, bool dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va) {
+  if (Fast(c) && (dbl ? SqrtFast<true>(lanes, d, s) : SqrtFast<false>(lanes, d, s)))
+    return;
   if (dbl)
     SqrtT<true>(c, lanes, d, s, va);
   else
@@ -347,12 +507,17 @@ uint32_t RsqrtLane(uint32_t x) {
   if (exp == 0) return (x & 0x80000000u) | 0x7F800000u;  // ±0, denormal: ±inf
   if (x & 0x80000000u) return 0xFFC00000u;               // negative: default NaN
   if (exp == 0xFF) return 0;                             // +inf: +0
-  const uint_fast8_t mode = softfloat_roundingMode, flags = softfloat_exceptionFlags;
-  softfloat_roundingMode = softfloat_round_near_even;
-  float64_t one{0x3FF0000000000000ull};
-  uint32_t r = f64_to_f32(f64_div(one, f64_sqrt(f32_to_f64(float32_t{x})))).v;
-  softfloat_roundingMode = mode;
-  softfloat_exceptionFlags = flags;
+  uint32_t r;
+  if (g_host_fast) {  // the same three RN roundings on the host (it is RN)
+    r = std::bit_cast<uint32_t>(float(1.0 / std::sqrt(double(std::bit_cast<float>(x)))));
+  } else {
+    const uint_fast8_t mode = softfloat_roundingMode, flags = softfloat_exceptionFlags;
+    softfloat_roundingMode = softfloat_round_near_even;
+    float64_t one{0x3FF0000000000000ull};
+    r = f64_to_f32(f64_div(one, f64_sqrt(f32_to_f64(float32_t{x})))).v;
+    softfloat_roundingMode = mode;
+    softfloat_exceptionFlags = flags;
+  }
   const unsigned __int128 mx = frac | 0x800000u;
   const int ex = int(exp) - 150;  // x = mx * 2^ex
   for (;;) {
@@ -382,6 +547,9 @@ void Rsqrt(Xmm& d, const Xmm& s) {
 void Cvtsi2sd(Xmm& d, int32_t v) { SetLane<uint64_t>(d, 0, i32_to_f64(v).v); }
 
 uint32_t CvtToI32(Ctx& c, bool dbl, const Xmm& s, bool truncate, uint64_t va) {
+  if (Fast(c))
+    return uint32_t(dbl ? CvtHost<int32_t>(HL<true>(s, 0), truncate)
+                        : CvtHost<int32_t>(HL<false>(s, 0), truncate));
   Scope sc(c, va);
   bool den = dbl ? IsDenormal<true>(Lane<uint64_t>(s, 0))
                  : IsDenormal<false>(Lane<uint32_t>(s, 0));
@@ -398,6 +566,9 @@ uint32_t CvtToI32(Ctx& c, bool dbl, const Xmm& s, bool truncate, uint64_t va) {
 }
 
 uint64_t CvtToI64(Ctx& c, bool dbl, const Xmm& s, bool truncate, uint64_t va) {
+  if (Fast(c))
+    return uint64_t(dbl ? CvtHost<int64_t>(HL<true>(s, 0), truncate)
+                        : CvtHost<int64_t>(HL<false>(s, 0), truncate));
   Scope sc(c, va);
   bool den = dbl ? IsDenormal<true>(Lane<uint64_t>(s, 0))
                  : IsDenormal<false>(Lane<uint32_t>(s, 0));
@@ -415,6 +586,13 @@ uint64_t CvtToI64(Ctx& c, bool dbl, const Xmm& s, bool truncate, uint64_t va) {
 
 void MinMax(Ctx& c, bool max, bool dbl, int lanes, Xmm& d, const Xmm& s,
             uint64_t va) {
+  if (Fast(c)) {
+    if (dbl)
+      MinMaxFast<true>(max, lanes, d, s);
+    else
+      MinMaxFast<false>(max, lanes, d, s);
+    return;
+  }
   if (dbl)
     MinMaxT<true>(c, max, lanes, d, s, va);
   else
@@ -422,6 +600,26 @@ void MinMax(Ctx& c, bool max, bool dbl, int lanes, Xmm& d, const Xmm& s,
 }
 
 void CvtFloat(Ctx& c, bool to_dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va) {
+  if (Fast(c)) {  // NaN operands (payload handling) take the exact path
+    Xmm r = d;
+    bool nan = false;
+    for (int i = 0; i < lanes; i++) {
+      if (to_dbl) {
+        const float a = HL<false>(s, i);
+        nan |= a != a;
+        HSet<true>(r, i, double(a));
+      } else {
+        const double a = HL<true>(s, i);
+        nan |= a != a;
+        HSet<false>(r, i, float(a));
+      }
+    }
+    if (!to_dbl && lanes == 2) SetLane<uint64_t>(r, 1, 0);
+    if (!nan) {
+      d = r;
+      return;
+    }
+  }
   Scope sc(c, va);
   Xmm r = d;
   if (to_dbl) {
@@ -437,6 +635,13 @@ void CvtFloat(Ctx& c, bool to_dbl, int lanes, Xmm& d, const Xmm& s, uint64_t va)
 }
 
 void CvtIntToF(Ctx& c, bool dbl, bool src64, uint64_t v, Xmm& d, uint64_t va) {
+  if (Fast(c)) {
+    if (dbl)
+      HSet<true>(d, 0, src64 ? double(int64_t(v)) : double(int32_t(v)));
+    else
+      HSet<false>(d, 0, src64 ? float(int64_t(v)) : float(int32_t(v)));
+    return;
+  }
   Scope sc(c, va);
   sc.Begin();
   if (dbl)
@@ -448,6 +653,14 @@ void CvtIntToF(Ctx& c, bool dbl, bool src64, uint64_t v, Xmm& d, uint64_t va) {
 }
 
 void CvtToDq(Ctx& c, bool dbl, bool truncate, Xmm& d, const Xmm& s, uint64_t va) {
+  if (Fast(c)) {
+    Xmm r{};
+    for (int i = 0; i < (dbl ? 2 : 4); i++)
+      SetLane<int32_t>(r, i, dbl ? CvtHost<int32_t>(HL<true>(s, i), truncate)
+                                 : CvtHost<int32_t>(HL<false>(s, i), truncate));
+    d = r;
+    return;
+  }
   Scope sc(c, va);
   const uint8_t mode = truncate ? uint8_t(softfloat_round_minMag) : RoundingMode(c.mxcsr);
   Xmm r{};
@@ -467,6 +680,12 @@ void CvtToDq(Ctx& c, bool dbl, bool truncate, Xmm& d, const Xmm& s, uint64_t va)
 }
 
 void Cvtdq2ps(Ctx& c, Xmm& d, const Xmm& s, uint64_t va) {
+  if (Fast(c)) {
+    Xmm r;
+    for (int i = 0; i < 4; i++) HSet<false>(r, i, float(Lane<int32_t>(s, i)));
+    d = r;
+    return;
+  }
   Scope sc(c, va);
   Xmm r;
   sc.Begin();
