 inline constexpr uint32_t kMxcsrDefault = 0x1F80;  // all masked, RN
 
+// Host fast path (sse.cpp): under the default MXCSR control bits, lanes
+// use host float/double arithmetic, bit-exact for every non-NaN result
+// (NaN results redo the instruction exactly), without accumulating the
+// MXCSR sticky flags. A title whose code reads MXCSR (STMXCSR) clears it
+// before guest code runs. Default on.
+extern bool g_host_fast;
+
 template <typename T>
 inline T Lane(const Xmm& x, int i) {
   T v;
