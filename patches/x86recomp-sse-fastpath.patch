diff --git a/tests/sse_fast_test.cpp b/tests/sse_fast_test.cpp
new file mode 100644
index 0000000..e7bc8dc
--- /dev/null
+++ b/tests/sse_fast_test.cpp
@@ -0,0 +1,230 @@
+// The SSE host fast path (runtime/sse.cpp, g_host_fast) against the exact
+// SoftFloat path: every float operation under the default MXCSR, on
+// special operands (zeros, denormals, extremes, infinities, QNaN and SNaN,
+// integer-conversion boundaries) and random bit patterns, must give the
+// same result bits. MXCSR sticky flags are not compared (the fast path
+// does not keep them by design). Exits 1 on any difference.
+//
+//   sse_fast_test [random cases per op, default 200000]
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "runtime/sse.h"
+
+namespace {
+using namespace recomp;
+using namespace recomp::sse;
+
+int g_fail = 0;
+long g_n = 0;
+std::mt19937_64 g_rng(12345);
+
+const uint32_t kF[] = {
+    0x00000000, 0x80000000, 0x00000001, 0x80000001, 0x007FFFFF, 0x807FFFFF, 0x00800000,
+    0x80800000, 0x7F7FFFFF, 0xFF7FFFFF, 0x7F800000, 0xFF800000, 0x7FC00000, 0xFFC00000,
+    0x7F800001, 0xFFA00000, 0x7FC12345, 0x3F800000, 0xBF800000, 0x3F000000, 0x3FC00000,
+    0x4EFFFFFF, 0x4F000000, 0xCF000000, 0xCF000001, 0x5EFFFFFF, 0x5F000000, 0xDF000000,
+    0xDF000001, 0x3F7FFFFF, 0x4B000001, 0x4B7FFFFF, 0x34000000, 0x0C000000, 0x1F800000,
+    0x5F800000, 0x40490FDB, 0xBEAAAAAB};
+const uint64_t kD[] = {
+    0x0000000000000000ull, 0x8000000000000000ull, 0x0000000000000001ull, 0x800FFFFFFFFFFFFFull,
+    0x0010000000000000ull, 0x7FEFFFFFFFFFFFFFull, 0xFFEFFFFFFFFFFFFFull, 0x7FF0000000000000ull,
+    0xFFF0000000000000ull, 0x7FF8000000000000ull, 0xFFF8000000000000ull, 0x7FF0000000000001ull,
+    0x7FF4000000000000ull, 0x3FF0000000000000ull, 0xBFF0000000000000ull, 0x3FE0000000000000ull,
+    0x41DFFFFFFFC00000ull, 0x41DFFFFFFFE00000ull, 0x41E0000000000000ull, 0xC1E0000000000000ull,
+    0xC1E0000000200000ull, 0xC1E0000000100000ull, 0x43DFFFFFFFFFFFFFull, 0x43E0000000000000ull,
+    0xC3E0000000000000ull, 0xC3E0000000000001ull, 0x47EFFFFFE0000000ull, 0x47EFFFFFF0000000ull,
+    0x36A0000000000000ull, 0x3690000000000000ull, 0x3810000000000000ull, 0x400921FB54442D18ull,
+    0x4330000000000001ull};
+
+uint32_t RandF() {
+  uint64_t r = g_rng();
+  switch (r & 7) {
+    case 0: return kF[(r >> 8) % (sizeof(kF) / 4)];
+    case 1: return uint32_t(r >> 32) & 0x80FFFFFF;  // tiny: denormal results
+    case 2: return (uint32_t(r >> 32) & 0x807FFFFF) | 0x3F000000;  // near 1
+    default: return uint32_t(r >> 32);
+  }
+}
+uint64_t RandD() {
+  uint64_t r = g_rng();
+  switch (r & 7) {
+    case 0: return kD[(r >> 8) % (sizeof(kD) / 8)];
+    case 1: return g_rng() & 0x80FFFFFFFFFFFFFFull;
+    case 2: return (g_rng() & 0x800FFFFFFFFFFFFFull) | 0x3FE0000000000000ull;
+    case 3: return g_rng() & 0x803FFFFFFFFFFFFFull;  // near the bottom of the range
+    default: return g_rng();
+  }
+}
+Xmm RandX(bool dbl) {
+  Xmm x;
+  for (int i = 0; i < (dbl ? 2 : 4); i++) {
+    if (dbl) SetLane<uint64_t>(x, i, RandD());
+    else SetLane<uint32_t>(x, i, RandF());
+  }
+  return x;
+}
+// Integer sources: random, and around the float rounding boundaries.
+uint64_t RandI() {
+  uint64_t r = g_rng();
+  switch (r & 3) {
+    case 0: return uint64_t(int64_t(int32_t(r >> 32)));
+    case 1: return (r >> 8) & 0x3FFFFFF;
+    default: return r;
+  }
+}
+
+Ctx MakeCtx() {
+  Ctx c;
+  std::memset(&c, 0, sizeof c);
+  c.mxcsr = kMxcsrDefault;
+  return c;
+}
+
+// Runs fn on (d, s) through both paths; compares d and the return value.
+template <typename Fn>
+void Both(const char* what, const Xmm& d0, const Xmm& s, Fn fn) {
+  Ctx c1 = MakeCtx(), c2 = MakeCtx();
+  Xmm d1 = d0, d2 = d0;
+  g_host_fast = true;
+  uint64_t r1 = fn(c1, d1, s);
+  g_host_fast = false;
+  uint64_t r2 = fn(c2, d2, s);
+  g_host_fast = true;
+  g_n++;
+  if (std::memcmp(d1.b, d2.b, 16) || r1 != r2) {
+    if (++g_fail <= 30) {
+      std::printf("FAIL %s: d ", what);
+      for (int i = 15; i >= 0; i--) std::printf("%02X", d0.b[i]);
+      std::printf(" s ");
+      for (int i = 15; i >= 0; i--) std::printf("%02X", s.b[i]);
+      std::printf("\n  fast ");
+      for (int i = 15; i >= 0; i--) std::printf("%02X", d1.b[i]);
+      std::printf(" r %llX\n  soft ", (unsigned long long)r1);
+      for (int i = 15; i >= 0; i--) std::printf("%02X", d2.b[i]);
+      std::printf(" r %llX\n", (unsigned long long)r2);
+    }
+  }
+}
+
+void Case(bool dbl, const Xmm& d, const Xmm& s, uint64_t iv) {
+  static const char* kOp[] = {"add", "sub", "mul", "div"};
+  const char* t = dbl ? "d" : "s";
+  char name[64];
+  for (int lanes : {1, dbl ? 2 : 4}) {
+    for (int op = 0; op < 4; op++) {
+      std::snprintf(name, sizeof name, "%s%s lanes %d", kOp[op], t, lanes);
+      Both(name, d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+        Arith(c, Op(op), dbl, lanes, x, y, 0);
+        return uint64_t(0);
+      });
+    }
+    std::snprintf(name, sizeof name, "sqrt%s lanes %d", t, lanes);
+    Both(name, d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      Sqrt(c, dbl, lanes, x, y, 0);
+      return uint64_t(0);
+    });
+    for (int mx = 0; mx < 2; mx++) {
+      std::snprintf(name, sizeof name, "%s%s lanes %d", mx ? "max" : "min", t, lanes);
+      Both(name, d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+        MinMax(c, mx, dbl, lanes, x, y, 0);
+        return uint64_t(0);
+      });
+    }
+    for (uint8_t pred = 0; pred < 8; pred++) {
+      std::snprintf(name, sizeof name, "cmp%s pred %d lanes %d", t, pred, lanes);
+      Both(name, d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+        Cmp(c, dbl, lanes, x, y, pred, 0);
+        return uint64_t(0);
+      });
+    }
+  }
+  for (int ord = 0; ord < 2; ord++)
+    Both(dbl ? "comisd" : "comiss", d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      return uint64_t(Comi(c, dbl, ord, x, y, 0));
+    });
+  for (int tr = 0; tr < 2; tr++) {
+    Both("cvt2si32", d, s, [&](Ctx& c, Xmm&, const Xmm& y) {
+      return uint64_t(CvtToI32(c, dbl, y, tr, 0));
+    });
+    Both("cvt2si64", d, s, [&](Ctx& c, Xmm&, const Xmm& y) {
+      return CvtToI64(c, dbl, y, tr, 0);
+    });
+    Both("cvt2dq", d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      CvtToDq(c, dbl, tr, x, y, 0);
+      return uint64_t(0);
+    });
+  }
+  // dbl: from double (CVTSD2SS/CVTPD2PS); else from float (to double).
+  for (int lanes : {1, 2})
+    Both(dbl ? "cvtpd2ps" : "cvtps2pd", d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      CvtFloat(c, !dbl, lanes, x, y, 0);
+      return uint64_t(0);
+    });
+  for (int src64 = 0; src64 < 2; src64++)
+    Both("cvtsi2f", d, s, [&](Ctx& c, Xmm& x, const Xmm&) {
+      CvtIntToF(c, dbl, src64, iv, x, 0);
+      return uint64_t(0);
+    });
+  if (!dbl) {
+    Both("cvtdq2ps", d, s, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      Cvtdq2ps(c, x, y, 0);
+      return uint64_t(0);
+    });
+    Xmm si;  // integer lanes
+    for (int i = 0; i < 4; i++) SetLane<uint32_t>(si, i, uint32_t(RandI()));
+    Both("cvtdq2ps int", d, si, [&](Ctx& c, Xmm& x, const Xmm& y) {
+      Cvtdq2ps(c, x, y, 0);
+      return uint64_t(0);
+    });
+    Both("rsqrtps", d, s, [&](Ctx&, Xmm& x, const Xmm& y) {
+      Rsqrt(x, y);
+      return uint64_t(0);
+    });
+  }
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  const long n = argc > 1 ? std::atol(argv[1]) : 200000;
+  // Every pair of special values, then random ones.
+  for (bool dbl : {false, true}) {
+    const int k = dbl ? int(sizeof(kD) / 8) : int(sizeof(kF) / 4);
+    for (int i = 0; i < k; i++)
+      for (int j = 0; j < k; j++) {
+        Xmm d, s;
+        for (int l = 0; l < (dbl ? 2 : 4); l++) {
+          if (dbl) {
+            SetLane<uint64_t>(d, l, kD[(i + l) % k]);
+            SetLane<uint64_t>(s, l, kD[(j + 3 * l) % k]);
+          } else {
+            SetLane<uint32_t>(d, l, kF[(i + l) % k]);
+            SetLane<uint32_t>(s, l, kF[(j + 3 * l) % k]);
+          }
+        }
+        Case(dbl, d, s, RandI());
+      }
+    for (long i = 0; i < n; i++) Case(dbl, RandX(dbl), RandX(dbl), RandI());
+  }
+  // The fast path is off outside the default MXCSR: FTZ set must not take it.
+  {
+    Ctx c = MakeCtx();
+    c.mxcsr = kMxcsrDefault | 0x8000;
+    Xmm d{}, s{};
+    SetLane<uint32_t>(d, 0, 0x3F800000);
+    SetLane<uint32_t>(s, 0, 0x3F800001);
+    g_host_fast = true;
+    Arith(c, kAdd, false, 1, d, s, 0);
+    g_n++;
+    if (!(c.mxcsr & 0x20)) {  // PE only comes from the exact path
+      g_fail++;
+      std::printf("FAIL: FTZ set, fast path taken (no PE)\n");
+    }
+  }
+  std::printf("sse_fast_test: %ld comparisons, %d failures\n", g_n, g_fail);
+  return g_fail ? 1 : 0;
+}
